
#include <stdio.h>

#define MAX 100

char stack[MAX];
int top = -1;

void push(char ch)
{
    stack[++top] = ch;
}

char pop()
{
    return stack[top--];
}

int precedence(char ch)
{
    if (ch == '^')
        return 3;
    else if (ch == '*' || ch == '/')
        return 2;
    else if (ch == '+' || ch == '-')
        return 1;
    else
        return 0;
}

int isOperand(char ch)
{
    if ((ch >= 'A' && ch <= 'Z') ||
        (ch >= 'a' && ch <= 'z') ||
        (ch >= '0' && ch <= '9'))
        return 1;

    return 0;
}

void reverse(char str[])
{
    int i = 0, j = 0;
    char temp;

    while (str[j] != '\0')
        j++;

    j--;

    while (i < j)
    {
        temp = str[i];
        str[i] = str[j];
        str[j] = temp;

        i++;
        j--;
    }
}

int main()
{
    char infix[MAX], prefix[MAX];
    char ch;
    int i, j = 0;

    printf("Enter infix expression: ");
    scanf("%s", infix);

    /* Step 1: Reverse infix */
    reverse(infix);

    /* Step 2: Change brackets */
    i = 0;

    while (infix[i] != '\0')
    {
        if (infix[i] == '(')
            infix[i] = ')';
        else if (infix[i] == ')')
            infix[i] = '(';

        i++;
    }

    i = 0;

    while (infix[i] != '\0')
    {
        ch = infix[i];

        if (isOperand(ch))
        {
            prefix[j++] = ch;
        }
        else if (ch == '(')
        {
            push(ch);
        }
        else if (ch == ')')
        {
            while (top != -1 && stack[top] != '(')
            {
                prefix[j++] = pop();
            }

            pop();
        }
        else
        {
            while (top != -1 &&
                   precedence(stack[top]) > precedence(ch))
            {
                prefix[j++] = pop();
            }

            push(ch);
        }

        i++;
    }

    while (top != -1)
    {
        prefix[j++] = pop();
    }

    prefix[j] = '\0';
    reverse(prefix);

    printf("Prefix expression: %s\n", prefix);

    return 0;
}
